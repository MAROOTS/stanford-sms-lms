{
	email kademieugine@gmail.com
	on_demand_tls {
		ask http://caddy-ask:8090/
	}
}

stanfordos.co.ke, www.stanfordos.co.ke {
	handle /api* {
		reverse_proxy backend:8080
	}

	@www host www.stanfordos.co.ke
	handle @www {
		root * /srv-www
		encode gzip
		try_files {path} {path}.html {path}/index.html /404.html
		file_server
	}

	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

files.stanfordos.co.ke {
	reverse_proxy minio:9000
}

*.stanfordos.co.ke {
	tls {
		on_demand
	}
	handle /api* {
		reverse_proxy backend:8080
	}
	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}